{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pero-program/1",
  "title": "Программа тренировок Pero",
  "type": "object",
  "required": ["format", "name", "schedule", "workouts"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "pero-program/1" },
    "name": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "level": { "enum": ["beginner", "intermediate", "advanced"] },
    "units": { "enum": ["kg", "lb"], "default": "kg" },
    "schedule": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "days"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "weekly" },
            "days": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "patternProperties": { "^(mon|tue|wed|thu|fri|sat|sun)$": { "$ref": "#/$defs/id" } }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "order"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "rotation" },
            "order": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
          }
        }
      ]
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["double", "linear", "none"], "default": "double" },
        "increment": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["week"],
        "additionalProperties": false,
        "properties": {
          "week": { "type": "integer", "minimum": 1 },
          "rir": { "$ref": "#/$defs/rir" },
          "sets_factor": { "type": "number", "exclusiveMinimum": 0 },
          "note": { "type": "string" }
        }
      }
    },
    "deload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "every_weeks": { "type": "integer", "minimum": 2 },
        "sets_factor": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "rir": { "$ref": "#/$defs/rir" }
      }
    },
    "warmup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suggest": { "type": "boolean" },
        "scheme": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["percent", "reps"],
            "additionalProperties": false,
            "properties": {
              "percent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
              "reps": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "custom_exercises": { "type": "array", "items": { "$ref": "#/$defs/exercise" } },
    "workouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "exercises"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "note": { "type": "string" },
          "exercises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["exercise", "sets", "reps"],
              "additionalProperties": false,
              "properties": {
                "exercise": { "$ref": "#/$defs/id" },
                "variant": { "$ref": "#/$defs/id" },
                "sets": { "type": "integer", "minimum": 1, "maximum": 20 },
                "reps": { "$ref": "#/$defs/reps" },
                "rir": { "$ref": "#/$defs/rir" },
                "rest": { "$ref": "#/$defs/duration" },
                "sides": { "enum": ["both", "each"] },
                "group": { "type": "string", "pattern": "^[A-Z]$" },
                "start_weight": { "type": "number", "minimum": 0 },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "reps": {
      "description": "8, \"8-12\", или для упражнений на время \"45s\", \"30-60s\"",
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "pattern": "^\\d+(-\\d+)?s?$" }
      ]
    },
    "rir": {
      "description": "0..5 или диапазон \"1-2\"",
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 5 },
        { "type": "string", "pattern": "^[0-5]-[0-5]$" }
      ]
    },
    "duration": {
      "description": "90, \"90s\", \"2m\", \"2m30s\"",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^(\\d+m)?(\\d+s)?$" }
      ]
    },
    "muscle": {
      "enum": ["chest", "lats", "upper_back", "lower_back", "traps", "front_delts", "side_delts", "rear_delts", "biceps", "triceps", "forearms", "quads", "hamstrings", "glutes", "adductors", "abductors", "calves", "abs"]
    },
    "exercise": {
      "type": "object",
      "required": ["id", "name", "muscles", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "muscles": {
          "type": "object",
          "required": ["primary"],
          "additionalProperties": false,
          "properties": {
            "primary": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/muscle" } },
            "secondary": { "type": "array", "items": { "$ref": "#/$defs/muscle" } }
          }
        },
        "type": { "enum": ["weight", "bodyweight", "time"] },
        "sides": { "enum": ["both", "each", "optional"], "default": "both" },
        "increment": { "type": "number", "exclusiveMinimum": 0 },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string" },
              "increment": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "tips": { "type": "array", "items": { "type": "string" } },
        "video": { "type": "string", "format": "uri" },
        "image": { "type": "string" }
      }
    }
  }
}
